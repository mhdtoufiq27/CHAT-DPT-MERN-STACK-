# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# MongoDB Database Connection String
# Example: mongodb://127.0.0.1:27017/chatdpt
MONGO_URI=mongodb://127.0.0.1:27017/chatdpt

# Cerebras AI API Key (Primary & Only AI Engine for VEXIS PRO)
# Get key from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-your_cerebras_api_key_here
CEREBRAS_MODEL=llama-3.3-70b
